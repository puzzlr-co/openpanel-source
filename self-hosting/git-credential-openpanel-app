#!/usr/bin/env bash
# Git credential helper for this checkout on the VPS: a one-hour, contents:read token for
# puzzlr-co/openpanel from the GitHub App puzzlr-openpanel-vps, whose private key is
# root-only at /root/.config/gh-app/openpanel.pem. Revoke by uninstalling the App.
# Install once: ln -s "$PWD/git-credential-openpanel-app" /usr/local/bin/ &&
#   git config credential.https://github.com.helper openpanel-app
set -euo pipefail
[ "${1:-}" = get ] || exit 0
APP_ID=5109280
INSTALLATION_ID=165834748
KEY=/root/.config/gh-app/openpanel.pem
b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
now=$(date +%s)
unsigned="$(printf '{"alg":"RS256"}' | b64).$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$APP_ID" | b64)"
jwt="$unsigned.$(printf '%s' "$unsigned" | openssl dgst -sha256 -sign "$KEY" -binary | b64)"
curl -fsS -X POST -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
  -d '{"repositories":["openpanel"],"permissions":{"contents":"read"}}' \
  "https://api.github.com/app/installations/$INSTALLATION_ID/access_tokens" |
  python3 -c 'import sys,json;print("username=x-access-token\npassword=" + json.load(sys.stdin)["token"])'
